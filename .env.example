# Pointili — environment variables.
# Copy to `.env.local` and fill in YOUR OWN values. `.env.local` is gitignored.
#
# Without the Supabase vars the app still runs: diner data persists to a
# dev-only JSON store (.data/), and the owner app opens without auth. That
# fallback is dev-only and can never activate in a production build.

# ── Supabase project (required for real auth + storage) ──────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Diner sessions (required) ───────────────────────────────────────
# Signs the phone+PIN session token. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DINER_SESSION_SECRET=

# ── Super-admin step-up (required to reach /admin) ───────────────────
# Signs the 30-minute elevated console cookie. MUST be a different secret from
# DINER_SESSION_SECRET: a leak of one must not be able to mint the other.
ADMIN_STEPUP_SECRET=

# ── Super-admin login (used only by the test scripts in /scripts) ────
# So no real credential is ever hard-coded in the repo.
SUPER_ADMIN_EMAIL=you@example.com
SUPER_ADMIN_PASSWORD=
# Comma-separated list of founder emails that seed.mjs marks as super_admin:
SUPER_ADMIN_EMAILS=you@example.com

# ── Public site URL (canonical URLs, sitemap, OG) ────────────────────
NEXT_PUBLIC_SITE_URL=https://pointili.online

# ── Transactional email (Resend) — NOT WIRED UP YET ──────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=Pointili <noreply@pointili.online>

# ── Optional secrets — NOT WIRED UP YET ─────────────────────────────
# SIGNUP_CODE_SECRET=
# PASSWORD_RESET_SECRET=
# QR_SESSION_SECRET=
# STAFF_SESSION_SECRET=
