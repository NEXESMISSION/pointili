# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template belongs in the repo
!.env.example

# dev-only JSON store (stand-in for Postgres until Supabase is wired)
.data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
scratch/
backups/

# marketing assets — they live in Desktop/"pointili postes", not in the app repo
postes/

# throwaway screenshot/debug scripts
scripts/_*.mjs

# Real people's data. Never.
#
# Leads carry the names of strangers who messaged the Page and what they asked.
# They live in `Desktop/pointili postes/crm/`, outside this repo, because this
# repo is pushed to GitHub. These rules are the second line of defence: if a
# lead file is ever copied in here by accident, git will not pick it up.
crm/
leads.json
*.leads.json
*-leads.json
contacts.json
